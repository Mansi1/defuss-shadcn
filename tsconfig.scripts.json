{
  // Why: scripts/ and tests/ tooling is TypeScript run directly by bun, but
  // the root tsconfig compiles only src/ (rootDir constraint). This config
  // exists so editors and `tsc` resolve Bun globals + playwright types for
  // the tooling tree. Not used by the build.
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts"]
}
